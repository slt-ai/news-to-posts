@echo off
rem ================================================================
rem  Запуск генератора постов (Windows)
rem  Просто дважды кликни по этому файлу или запусти в командной строке.
rem ================================================================

rem Переходим в папку с этим файлом, чтобы всё работало из любого места
cd /d "%~dp0"

rem Включаем виртуальное окружение из папки .venv
call ".venv\Scripts\activate.bat"

rem Запускаем сайт (настройки берутся из файла .env)
python app.py
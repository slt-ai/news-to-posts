# ============================================================
# ШАБЛОН НАСТРОЕК ДЛЯ Git (не секрет).
# Скопируй этот файл в .env и впиши свой ключ:
#   copy .env.example .env
# ============================================================

HOST=127.0.0.1
PORT=5000
DEBUG=1

# ВСТАВЬ СВОЙ КЛЮЧ: https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Адрес API Ollama Cloud
OLLAMA_HOST=https://ollama.com

# Модель по умолчанию (список и цены: https://ollama.com/pricing)
# Рекомендуем gemma4 — пишет готовый пост сразу, без «рассуждений».
OLLAMA_MODEL=gemma4

# ============================================================
# ВКОНТАКТЕ — публикация в сообщество
# Подробная инструкция простым языком: файл ВК_ИНСТРУКЦИЯ.md
# ============================================================

# Ключ сообщества (токен). Где взять:
# сообщество → Управление → Работа с API → Создать токен
# (нужны права на стену и фото). Пример: vk1.a.abc123...
VK_ACCESS_TOKEN=

# ID сообщества — только цифры, без минуса и без букв «club».
# Где взять: открой сообщество, цифры в ссылке vk.com/club123456789
# или в Управлении → внизу страницы.
VK_GROUP_ID=
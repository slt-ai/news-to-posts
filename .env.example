# ============================================================
# ШАБЛОН НАСТРОЕК ДЛЯ Git (не секрет).
# Скопируй этот файл в .env и впиши свой ключ:
#   copy .env.example .env
# ============================================================

HOST=127.0.0.1
PORT=5000
DEBUG=1

# ВСТАВЬ СВОЙ КЛЮЧ: https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Адрес API Ollama Cloud
OLLAMA_HOST=https://ollama.com

# Модель по умолчанию (список и цены: https://ollama.com/pricing)
# Рекомендуем gemma4 — пишет готовый пост сразу, без «рассуждений».
OLLAMA_MODEL=gemma4